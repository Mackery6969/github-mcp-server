# GitHub MCP Server — Environment variables
# Copy this file to .env and fill in your values.
# Add .env to .gitignore — never commit secrets.

# ── GitHub App Authentication (preferred for agents/bots) ─────────
# Required: App ID (numeric, from GitHub App settings)
GITHUB_APP_ID=

# Required: Installation ID (from gh api user/installations)
GITHUB_APP_INSTALLATION_ID=

# Required: Path to private key PEM file
# You can also use GITHUB_APP_PRIVATE_KEY with inline PEM content
GITHUB_APP_PRIVATE_KEY_PATH=

# ── OAuth Authentication (interactive login) ──────────────────────
# Client ID from your GitHub OAuth App settings
GITHUB_OAUTH_CLIENT_ID=

# Client secret (only if your app requires one)
GITHUB_OAUTH_CLIENT_SECRET=

# Callback port for Docker (must be published: -p 127.0.0.1:8085:8085)
GITHUB_OAUTH_CALLBACK_PORT=8085

# Requested OAuth scopes (comma-separated; also filters tools)
GITHUB_OAUTH_SCOPES=repo,read:org,workflow,notifications

# ── Personal Access Token (simplest, takes precedence) ────────────
# GitHub PAT with appropriate scopes
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── GitHub Enterprise ─────────────────────────────────────────────
# For GHE or ghe.com (prefix with https://)
GITHUB_HOST=

# ── Server Configuration ──────────────────────────────────────────
# Comma-separated toolsets to enable (default: all)
# Example: repos,issues,pull_requests,actions
GITHUB_TOOLSETS=

# Specific tools to enable (can be combined with toolsets)
# Example: get_file_contents,issue_read
GITHUB_TOOLS=

# Run in read-only mode (no write operations)
GITHUB_READ_ONLY=

# Custom log file path
GITHUB_LOG_FILE=
